# --- Server ---
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000

# --- Database ---
MONGODB_URI=mongodb://127.0.0.1:27017/northstar_financial

# --- Session / CSRF secrets (generate your own random strings in real deployments) ---
SESSION_SECRET=northstar-session-secret-change-me-please-1234567890
CSRF_SECRET=northstar-csrf-secret-change-me-please-0987654321

# --- Seeded demo identity (used only by seed.js) ---
DEMO_USERNAME=donald2026
DEMO_PASSWORD=donald2026
# 4-digit PIN required to confirm a transfer.
TRANSACTION_PIN=0000

# --- Email ---
# EMAIL_TRANSPORT=stream writes real .eml files to sent-emails/ and makes no network call.
# EMAIL_TRANSPORT=smtp sends via a real SMTP server using the SMTP_* variables below.
EMAIL_TRANSPORT=stream
EMAIL_FROM="Northstar Financial <no-reply@northstarfinancial.example>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
